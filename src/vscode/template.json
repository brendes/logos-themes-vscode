{
  "$schema": "vscode://schemas/color-theme",
  "name": "{name}",
  "type": "{type}",
  "tokenColors": [
    {
      "name": "Keywords and Operators",
      "scope": [
        "keyword",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "{text_normal}"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "{text_muted}"
      }
    },
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "{text_dim}"
      }
    },
    {
      "name": "Errors",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "{color_red}"
      }
    },
    {
      "name": "Sections and headings",
      "scope": [
        "entity.name.section.markdown",
        "heading",
        "markup.heading"
      ],
      "settings": {
        "foreground": "{text_normal}",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Inline code",
      "scope": [
        "markup.inline"
      ],
      "settings": {
        "foreground": "{text_normal}"
      }
    },
    {
      "name": "Uncolored overrides",
      "scope": [
        "entity.name.tag.yaml",
        "punctuation.section.block",
        "support.type.property-name.json"
      ],
      "settings": {
        "foreground": "{text_normal}"
      }
    }
  ],
  "colors": {
